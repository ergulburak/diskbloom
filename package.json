{
  "name": "diskbloom",
  "productName": "Diskbloom",
  "version": "0.2.0",
  "description": "A pastel, animated disk space visualizer and cleaner for Windows.",
  "main": "src/main/main.js",
  "author": "ergulburak",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test \"test/**/*.test.{js,mjs}\"",
    "e2e": "node scripts/e2e.mjs",
    "capture": "node scripts/capture.mjs docs/media",
    "build:scanner": "node scripts/build-scanner.js",
    "dist": "npm run build:scanner && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.diskbloom.app",
    "productName": "Diskbloom",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/scanner.exe",
        "to": "scanner.exe"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
